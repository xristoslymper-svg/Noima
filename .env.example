# Phase 2 uses these public, RLS-protected connection settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never prefix a privileged key with NEXT_PUBLIC_. No privileged key is needed for ordinary clinical access.

# Server-only OpenAI key for GPT speech-to-text. Never expose this with NEXT_PUBLIC_.
OPENAI_API_KEY=
